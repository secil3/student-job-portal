DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=replace-with-demo-only-mysql-user
DB_PASSWORD=replace-with-demo-only-mysql-password
DB_NAME=student_job_portal_demo
JWT_SECRET=replace-with-a-strong-demo-only-secret
PORT=5050

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-gmail-address
SMTP_APP_PASSWORD=replace-with-google-app-password
EMAIL_FROM="StudentJob <replace-with-gmail-address>"
FRONTEND_URL=http://localhost:5173

GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Render supplies PORT. Set NODE_ENV=production and FRONTEND_URL to the demo HTTPS origin.
DEMO_MODE=true
DEMO_AI_MODE=mock
RESUME_STORAGE_DIR=./demo-storage/resumes

# Aiven: replace DB_HOST/DB_PORT above and enable verified TLS.
DB_SSL=false
# DB_SSL_CA=provider-ca-pem-with-escaped-newlines
# DB_SSL_CA_PATH=./certs/aiven-ca.pem
# File path takes precedence; relative paths resolve from the backend directory.

# Only needed for the separately approved, one-time demo seed (minimum 12 characters).
DEMO_STUDENT_PASSWORD=replace-with-demo-only-student-password
DEMO_EMPLOYER_PASSWORD=replace-with-demo-only-employer-password
DEMO_ADMIN_PASSWORD=replace-with-demo-only-admin-password
